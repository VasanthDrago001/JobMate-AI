# JobMate AI - Monorepo Environment Configuration Template
# Copy this file to backend/.env and frontend/.env respectively

# ==========================================
# Backend Configuration (backend/.env)
# ==========================================
PROJECT_NAME=JobMate AI Backend
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True

HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Free Tier LLM API Key (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

MAX_FILE_SIZE_MB=5
MAX_RESUME_PAGES=3

# ==========================================
# Frontend Configuration (frontend/.env)
# ==========================================
VITE_API_BASE_URL=http://127.0.0.1:8000
