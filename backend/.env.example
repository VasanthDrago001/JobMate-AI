# JobMate AI Backend - Environment Configuration Template
# Copy this file to .env and adjust variables as needed

PROJECT_NAME=JobMate AI Backend
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True

# Server settings
HOST=127.0.0.1
PORT=8000

# Allowed Origins (Comma-separated or JSON list for CORS)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# LLM Configuration (Placeholders for future phases)
# Free Tier API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (Supabase PostgreSQL placeholder)
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# Security Constraints
MAX_FILE_SIZE_MB=5
MAX_RESUME_PAGES=3
