# JobMate AI Backend - Environment Configuration Template
# Copy this file to .env and adjust variables as needed

PROJECT_NAME=JobMate AI Backend
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True

# Server settings
HOST=127.0.0.1
PORT=8000

# Allowed Origins (Comma-separated or JSON list for CORS)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# LLM & AI Service Configuration
# Free Tier API Key from Google AI Studio: https://aistudio.google.com/
# NEVER commit your actual API key to Git. Add it ONLY in backend/.env (which is in .gitignore).
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash
AI_ENABLED=True

# Cost & Usage Controls
# Maximum AI calls permitted per day across the server to prevent runaway costs
AI_DAILY_BUDGET_CALLS=50
AI_MAX_BULLETS_PER_REQUEST=3
AI_MAX_BULLET_CHARS=400
AI_MAX_OUTPUT_TOKENS=800
AI_REQUEST_TIMEOUT_SECONDS=8.0

# Database Configuration (Supabase PostgreSQL placeholder)
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# Security Constraints
MAX_FILE_SIZE_MB=5
MAX_RESUME_PAGES=5
